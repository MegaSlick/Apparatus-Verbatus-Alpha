#!/bin/sh
# git does not run pre-commit for a clean merge, so this hook runs it instead:
# a merge commit gets the same main-branch refusal and staged-content scan.

hook="$(dirname "$0")/pre-commit"
if [ ! -f "$hook" ]; then
  echo "" >&2
  echo "  BLOCKED: ${hook} is missing, so this merge commit cannot be checked." >&2
  echo "  A check that cannot run is a failure, not a pass." >&2
  echo "" >&2
  exit 1
fi

exec sh "$hook"
