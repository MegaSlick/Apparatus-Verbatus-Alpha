#!/bin/sh
# Branch rules, enforced locally so they bind every tool — Claude, Codex, GPT, you.
# GitHub cannot enforce these: free-plan private repos have no branch protection.
#
# Escape hatches, to be used knowingly and rarely:
#   ALLOW_MAIN_PUSH=1       push directly to main
#   ALLOW_FORCE_PUSH=1      rewrite a branch's history
#   ALLOW_ANY_BRANCH=1      push a branch outside the naming convention
#   ALLOW_UNAUDITED_PUSH=1  push work no agent has reviewed

z40='0000000000000000000000000000000000000000'

# Where audit receipts live: the *common* git directory, so every worktree
# shares one record. Never committed — a receipt is evidence about a local
# working session, not a document.
receipts="$(git rev-parse --path-format=absolute --git-common-dir)/audit-receipts"

block() {
  echo "" >&2
  echo "  BLOCKED: $1" >&2
  echo "" >&2
  [ -n "$2" ] && { echo "  $2" >&2; echo "" >&2; }
  exit 1
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  branch=${remote_ref#refs/heads/}

  # Deleting a branch is normal cleanup after a merge — allow it, except for main.
  if [ "$local_sha" = "$z40" ]; then
    [ "$branch" = "main" ] && block "deleting main."
    continue
  fi

  # 1. main moves only by merging a pull request.
  if [ "$branch" = "main" ] && [ "$ALLOW_MAIN_PUSH" != "1" ]; then
    block "direct push to main." \
"main moves only by merge. Put this on a branch:
      git switch -c work/<short-topic> && git push -u origin work/<short-topic>"
  fi

  # 2. Branch names describe the work, and there are only three kinds.
  if [ "$branch" != "main" ] && [ "$ALLOW_ANY_BRANCH" != "1" ]; then
    case "$branch" in
      work/*|audit/*|infra/*) : ;;
      *) block "branch name '$branch' is not one of the three kinds." \
"      work/<topic>   a normal change
      audit/<topic>  a review that produces findings, not code
      infra/<topic>  risky structural work" ;;
    esac
  fi

  # 3. Never rewrite history someone else may be holding.
  #    Detects --force and --force-with-lease alike: the remote tip must be an
  #    ancestor of what you are pushing.
  if [ "$remote_sha" != "$z40" ] && [ "$ALLOW_FORCE_PUSH" != "1" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      block "force-push to '$branch' — this rewrites history." \
"Another agent may be working from these commits. Pull and merge instead."
    fi
  fi

  # 4. Nothing leaves this machine that no second pair of eyes has read.
  #    Tyrel merges; that is the outer check. This is the inner one: an agent
  #    audits the work before it is pushed at all, so what reaches a pull
  #    request has already been read by someone other than whoever wrote it.
  #    Write the receipt with .githooks/record-audit.sh after the audit runs.
  if [ "$ALLOW_UNAUDITED_PUSH" != "1" ] && [ ! -f "$receipts/$local_sha" ]; then
    block "'$branch' has no audit receipt for $(echo "$local_sha" | cut -c1-8)." \
"Nothing is pushed until an agent has read it. Run an audit, then:

      .githooks/record-audit.sh <auditor> '<what it found>'

  The receipt names one commit. Amend or add another and it must be
  audited again — which is the point.

  Subagents and other AI tools do not push at all. They audit and report;
  the push is Tyrel's or the main session's to make afterwards."
  fi
done
exit 0
