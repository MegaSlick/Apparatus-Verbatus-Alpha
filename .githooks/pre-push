#!/bin/sh
# Branch rules, enforced locally so they bind every tool — Claude, Codex, GPT, you.
# They catch a mistake here, at the moment it is made, with a message that says
# what to do instead. What `main` itself will accept is settled server-side and
# is not this file's business — see README.md.
#
# Escape hatches, to be used knowingly and rarely:
#   ALLOW_MAIN_PUSH=1       push directly to main
#   ALLOW_FORCE_PUSH=1      rewrite a branch's history
#   ALLOW_ANY_BRANCH=1      push a branch outside the naming convention
#   ALLOW_UNAUDITED_PUSH=1  push work no agent has reviewed

z40='0000000000000000000000000000000000000000'

# Where audit receipts live: the *common* git directory, so every worktree
# shares one record. Never committed — a receipt is evidence about a local
# working session, not a document.
#
# Resolved carefully. If this came back empty the path would become
# /audit-receipts, every push would be refused, and nobody would guess why.
# `cd ""` succeeds and stays put, so guard the inner command, not the cd —
# otherwise a failed rev-parse silently yields $PWD and looks like an answer.
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=""
if [ -z "$common" ]; then
  relative=$(git rev-parse --git-common-dir 2>/dev/null) || relative=""
  if [ -n "$relative" ]; then
    common=$(cd "$relative" 2>/dev/null && pwd) || common=""
  fi
fi
if [ -z "$common" ]; then
  echo "" >&2
  echo "  BLOCKED: cannot locate the git directory, so the audit gate" >&2
  echo "  cannot check anything. A check that cannot run is a failure," >&2
  echo "  not a pass. Set ALLOW_UNAUDITED_PUSH=1 only if you understand why." >&2
  echo "" >&2
  exit 1
fi
receipts="$common/audit-receipts"

block() {
  echo "" >&2
  echo "  BLOCKED: $1" >&2
  echo "" >&2
  [ -n "$2" ] && { echo "  $2" >&2; echo "" >&2; }
  exit 1
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*)
      kind=branch
      name=${remote_ref#refs/heads/}
      ;;
    refs/tags/*)
      kind=tag
      name=${remote_ref#refs/tags/}
      ;;
    *)
      block "push to unsupported ref '$remote_ref'." \
"Only branches and tags have a declared policy here. Refuse an unknown
  ref rather than letting it leave unchecked."
      ;;
  esac

  # Deleting a branch or tag is normal cleanup — allow it, except for main.
  if [ "$local_sha" = "$z40" ]; then
    [ "$kind" = "branch" ] && [ "$name" = "main" ] && block "deleting main."
    continue
  fi

  # 1. main moves only by merging a pull request.
  if [ "$kind" = "branch" ] && [ "$name" = "main" ] && [ "$ALLOW_MAIN_PUSH" != "1" ]; then
    block "direct push to main." \
"main moves only by merge. Put this on a branch:
      git switch -c work/<short-topic> && git push -u origin work/<short-topic>"
  fi

  # 2. Branch names describe the work, and there are only three kinds.
  if [ "$kind" = "branch" ] && [ "$name" != "main" ] && [ "$ALLOW_ANY_BRANCH" != "1" ]; then
    case "$name" in
      work/*|audit/*|infra/*) : ;;
      *) block "branch name '$name' is not one of the three kinds." \
"      work/<topic>   a normal change
      audit/<topic>  a review that produces findings, not code
      infra/<topic>  risky structural work" ;;
    esac
  fi

  # 3. Never rewrite history someone else may be holding.
  #    Detects --force and --force-with-lease alike: the remote tip must be an
  #    ancestor of what you are pushing. Published tags are immutable too.
  if [ "$kind" = "branch" ] && [ "$remote_sha" != "$z40" ] && \
     [ "$ALLOW_FORCE_PUSH" != "1" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      block "force-push to '$name' — this rewrites history." \
"Another agent may be working from these commits. Pull and merge instead."
    fi
  fi
  if [ "$kind" = "tag" ] && [ "$remote_sha" != "$z40" ] && \
     [ "$ALLOW_FORCE_PUSH" != "1" ]; then
    block "moving existing tag '$name' — tags are immutable once published." \
"Create a new tag. ALLOW_FORCE_PUSH=1 exists for an intentional exceptional move."
  fi

  # An annotated tag's local SHA names the tag object, while audits name the
  # commit that was read. Peel every ref to its commit so a tag at an audited
  # HEAD is usable and a tag pointing at a non-commit fails closed.
  audit_sha=$(git rev-parse "$local_sha^{commit}" 2>/dev/null) || audit_sha=""
  if [ -z "$audit_sha" ]; then
    block "'$name' does not resolve to a commit, so the audit gate cannot check it."
  fi

  # 4. Nothing leaves this machine that three reviewers have not read.
  #    Whoever wrote the work does not get to be the only one who has seen it
  #    leave, and one reviewer that shares the author's blind spots is not
  #    much better than none. Record each with .githooks/record-audit.sh; they
  #    accumulate in one receipt rather than overwriting each other.
  #    The receipt must name the commit it covers, so an empty file dropped in
  #    by `touch` does not read as a review. This raises the bar; it is not a
  #    lock, and nothing here can tell an author from an auditor.
  reviewers=0
  if grep -qx "commit:  $audit_sha" "$receipts/$audit_sha" 2>/dev/null; then
    # Distinct names, not lines: three entries from one reviewer is one
    # reviewer with a stutter, and the whole point is independent readers.
    reviewers=$(grep '^auditor:' "$receipts/$audit_sha" | sort -u | wc -l | tr -d ' ')
  fi
  if [ "$ALLOW_UNAUDITED_PUSH" != "1" ] && [ "$reviewers" -lt 3 ]; then
    block "$kind '$name' has $reviewers of 3 reviewers for $(echo "$audit_sha" | cut -c1-8)." \
"Three reviewers read the work before it is pushed — Claude Opus 5, Claude
  Fable 5, and GPT — on an identical prompt, blind to each other. Record
  each one as it reports:

      .githooks/record-audit.sh <reviewer> '<what it found>'

  They accumulate; none overwrites another. The receipt names one commit,
  so amending or adding one means auditing again — which is the point.

  Subagents and other AI tools do not push at all. They review and report;
  the push is Tyrel's or the main session's to make afterwards.

  ALLOW_UNAUDITED_PUSH=1 if you genuinely mean to skip this."
  fi
done
exit 0
