#!/bin/sh
# Refuses a commit whose message, author or committer header matches a known
# credential pattern. AI attribution (Co-Authored-By / Reviewed-by) is a convention
# described in CONTRIBUTING.md, not enforced here.

message=$1
if [ -z "$message" ] || [ ! -f "$message" ]; then
  echo "  BLOCKED: no commit message to read, so it cannot be checked." >&2
  exit 1
fi

# CI repeats this scan over every reachable commit message.
ingress="$(dirname "$0")/check_ingress.py"
if [ ! -f "$ingress" ]; then
  echo "  BLOCKED: $ingress is missing, so the commit message cannot be checked." >&2
  exit 1
fi
# check_ingress.py exits 1 for a recognised credential and 2 when it could not read
# its input; both block, but the message says which. The status is captured on its
# own line because `$?` after an `if` compound is the compound's status.
python3 "$ingress" --message-file "$message" >/dev/null
status=$?
if [ "$status" -ne 0 ]; then
  if [ "$status" -eq 1 ]; then
    echo "  BLOCKED: the commit message matched a recognized credential pattern." >&2
  else
    echo "  BLOCKED: the commit message could not be checked for credentials" >&2
    echo "  (the ingress check exited ${status}, meaning it could not run)." >&2
    echo "  Nothing is claimed about the message either way; the commit is" >&2
    echo "  refused because unknown is not the same as clean." >&2
  fi
  exit 1
fi

# The author and committer headers carry operator-supplied text into the commit
# object, and until now nothing looked at them: `git commit --author='...'` and
# a pasted `user.name` will carry a token as happily as any prose. Read from
# `git var`, which is what git itself will record — it reflects --author, the
# GIT_AUTHOR_*/GIT_COMMITTER_* environment and the configured identity alike.
#
# Handed to --ref-fields, the existing NUL-delimited contract, which fingerprints
# each field instead of echoing it. An identity that failed a scan must not be
# reprinted to a terminal, a log or a transcript on its way out.
# An unreadable identity is not an unrun check here, and treating it as one was
# wrong: `git var GIT_AUTHOR_IDENT` fails precisely when no user.name and
# user.email are configured, and in that state there is no identity for the
# commit to carry, so there is nothing to leak. Git refuses the commit itself,
# for its own reasons, immediately after this hook returns. Blocking here made
# the hook unusable anywhere an identity is not configured — every CI runner,
# every fresh container — which is how a fail-closed instinct turns into a
# check nobody can run at all.
author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null) || author_ident=""
committer_ident=$(git var GIT_COMMITTER_IDENT 2>/dev/null) || committer_ident=""

status=0
if [ -n "$author_ident" ] || [ -n "$committer_ident" ]; then
  printf '%s\0%s\0' "$author_ident" "$committer_ident" |
    python3 "$ingress" --ref-fields
  status=$?
fi
if [ "$status" -ne 0 ]; then
  if [ "$status" -eq 1 ]; then
    echo "  BLOCKED: the author or committer header matched a recognized" >&2
    echo "  credential pattern. The offending text is not reprinted here." >&2
    echo "  Check what --author, user.name/user.email and the GIT_AUTHOR_*" >&2
    echo "  and GIT_COMMITTER_* variables are set to." >&2
  else
    echo "  BLOCKED: the author and committer headers could not be checked" >&2
    echo "  (the ingress check exited ${status}, meaning it could not run)." >&2
  fi
  exit 1
fi
