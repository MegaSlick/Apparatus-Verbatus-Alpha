#!/bin/sh
# Refuses a commit whose message, author or committer header carries a credential.

message=$1
if [ -z "$message" ] || [ ! -f "$message" ]; then
  echo "  BLOCKED: no commit message to read, so it cannot be checked." >&2
  exit 1
fi

# CI repeats this scan over every reachable commit message.
ingress="$(dirname "$0")/check_ingress.py"
if [ ! -f "$ingress" ]; then
  echo "  BLOCKED: $ingress is missing, so the commit message cannot be checked." >&2
  exit 1
fi
# Exit 1 is a credential, 2 an unrun check; `$?` after an `if` would be the if's.
python3 "$ingress" --message-file "$message" >/dev/null
status=$?
if [ "$status" -ne 0 ]; then
  if [ "$status" -eq 1 ]; then
    echo "  BLOCKED: the commit message matched a recognized credential pattern." >&2
  else
    echo "  BLOCKED: the commit message could not be checked for credentials" >&2
    echo "  (the ingress check exited ${status}, meaning it could not run)." >&2
    echo "  Nothing is claimed about the message either way; the commit is" >&2
    echo "  refused because unknown is not the same as clean." >&2
  fi
  exit 1
fi

# No identity configured means nothing to leak, and git refuses that commit itself.
author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null) || author_ident=""
committer_ident=$(git var GIT_COMMITTER_IDENT 2>/dev/null) || committer_ident=""

status=0
if [ -n "$author_ident" ] || [ -n "$committer_ident" ]; then
  printf '%s\0%s\0' "$author_ident" "$committer_ident" |
    python3 "$ingress" --ref-fields
  status=$?
fi
if [ "$status" -ne 0 ]; then
  if [ "$status" -eq 1 ]; then
    echo "  BLOCKED: the author or committer header matched a recognized" >&2
    echo "  credential pattern. The offending text is not reprinted here." >&2
    echo "  Check what --author, user.name/user.email and the GIT_AUTHOR_*" >&2
    echo "  and GIT_COMMITTER_* variables are set to." >&2
  else
    echo "  BLOCKED: the author and committer headers could not be checked" >&2
    echo "  (the ingress check exited ${status}, meaning it could not run)." >&2
  fi
  exit 1
fi
