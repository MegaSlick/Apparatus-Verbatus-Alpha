#!/bin/sh
# A patch's message and author come from outside this repository, and they are
# read before anything is applied.
#
# `git am` runs THIS hook — not `commit-msg`, which it never runs at all — with
# the proposed commit message as $1, before the patch touches the working tree.
# So until this file existed, the prose most likely to carry a pasted token was
# the one text nothing here read: a mailing-list post, a colleague's export, a
# patch pulled out of a bug report.
#
# Verified against git 2.55.0 rather than assumed:
#   * $1 is the message file, the same shape `commit-msg` receives — so the
#     message half delegates rather than growing a second credential scan. Two
#     copies of a check drift, and this repository has been bitten by exactly
#     that. Everything `commit-msg` enforces applies here by construction,
#     including the attribution rule and its ALLOW_UNATTRIBUTED=1 hatch. A patch
#     from a human with no machine in it is what that hatch is for.
#   * GIT_AUTHOR_NAME and GIT_AUTHOR_EMAIL are NOT in the environment here, and
#     `git var GIT_AUTHOR_IDENT` answers with the *local* identity rather than
#     the patch's. So the delegated identity scan covers who is applying the
#     patch, and this hook covers who wrote it. The incoming author lives in
#     git's own .git/rebase-apply/author-script, which mailinfo writes before
#     this hook runs.
#
# The author fields are scanned as file bytes, never evaluated. author-script is
# shell-shaped text (GIT_AUTHOR_NAME='...') that arrived in a patch from
# somewhere else; sourcing it to read a variable would hand an incoming file the
# ability to run commands during a security check. The scanner reports a rule
# and a path, never the matched text.
#
# KNOWN GAP, stated rather than left silent: git does not run this hook on
# `git am --continue`. A patch that stops on a conflict was already checked when
# `git am` first ran, and `--continue` does not reopen the message, so the text
# that lands is text this hook read — but an operator who edits
# .git/rebase-apply/final-commit by hand during the pause is not re-checked.
# CI's history scan is what covers that.

ingress="$(dirname "$0")/check_ingress.py"
if [ ! -f "$ingress" ]; then
  echo "  BLOCKED: ${ingress} is missing, so the patch cannot be checked." >&2
  exit 1
fi

if ! author_script=$(git rev-parse --git-path rebase-apply/author-script 2>/dev/null) ||
   [ -z "$author_script" ]; then
  echo "  BLOCKED: git could not say where the incoming patch's author fields" >&2
  echo "  are recorded, so they cannot be checked. A check that cannot run is" >&2
  echo "  a failure, not a pass." >&2
  exit 1
fi

if [ ! -f "$author_script" ]; then
  echo "  BLOCKED: the incoming patch's author fields are not where git writes" >&2
  echo "  them (${author_script}), so the patch author cannot be checked for" >&2
  echo "  credentials. A check that cannot run is a failure, not a pass." >&2
  exit 1
fi

# Captured on its own line: after an `if` compound completes, `$?` holds the
# compound's status rather than the condition's, which would collapse "found a
# credential" and "could not look" into one answer.
python3 "$ingress" --file "$author_script"
status=$?
if [ "$status" -ne 0 ]; then
  if [ "$status" -eq 1 ]; then
    echo "" >&2
    echo "  BLOCKED: the incoming patch's author header matched a recognized" >&2
    echo "  credential pattern. The offending text is not reprinted here." >&2
    echo "" >&2
    echo "  This is the patch's own From: line, not your identity. The patch" >&2
    echo "  has not been applied. Read the file before applying it again." >&2
    echo "" >&2
  else
    echo "  BLOCKED: the incoming patch's author header could not be checked" >&2
    echo "  (the ingress check exited ${status}, meaning it could not run)." >&2
  fi
  exit 1
fi

hook="$(dirname "$0")/commit-msg"
if [ ! -f "$hook" ]; then
  echo "  BLOCKED: ${hook} is missing, so the patch message cannot be checked." >&2
  exit 1
fi

exec sh "$hook" "$@"
