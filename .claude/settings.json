{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "PONYTAIL_SUBAGENT_MATCHER": "(?!)"
  },
  "permissions": {
    "deny": [
      "Bash(git*push*origin main)",
      "Bash(git*push*origin main *)",
      "Bash(git*push*:main)",
      "Bash(git*push*:main *)",
      "Bash(git*push*refs/heads/main)",
      "Bash(git*push*refs/heads/main *)",
      "Bash(git*merge*--no-verify*)",
      "Bash(git*push*--force*)",
      "Bash(git*push* -f*)",
      "Bash(git*push*--mirror*)",
      "Bash(git*push*--delete*)",
      "Bash(git*commit*--no-verify*)",
      "Bash(git*commit* -n*)",
      "Bash(git*-c core.hooksPath*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath*)",
      "Bash(git*filter-branch*)",
      "Bash(git*filter-repo*)",
      "Bash(git*reset --hard*)",
      "Bash(runpodctl*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/operations/notify/notify.sh\" start \"An Apparatus Verbatus session has opened.\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
