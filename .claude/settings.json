{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git*push*--force*)",
      "Bash(git*push* -f*)",
      "Bash(git*commit*--no-verify*)",
      "Bash(git*commit* -n*)",
      "Bash(git*merge*--no-verify*)",
      "Bash(git*filter-branch*)",
      "Bash(git*filter-repo*)",
      "Bash(git*-c core.hooksPath*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath*)",
      "Bash(*curl*scantailor*)",
      "Bash(*curl*ScanTailor*)",
      "Bash(*curl*4lex4*)",
      "Bash(*wget*scantailor*)",
      "Bash(*wget*ScanTailor*)",
      "Bash(*wget*4lex4*)",
      "Bash(*git*clone*scantailor*)",
      "Bash(*git*clone*ScanTailor*)",
      "Bash(*git*clone*4lex4*)",
      "Bash(*git*fetch*scantailor*)",
      "Bash(*git*fetch*ScanTailor*)",
      "Bash(*git*fetch*4lex4*)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file"
    ],
    "ask": [
      "Bash(runpodctl create*)",
      "Bash(runpodctl pod create*)",
      "Bash(runpodctl start*)",
      "Bash(runpodctl pod start*)",
      "Bash(runpodctl resume*)",
      "Bash(runpodctl pod resume*)",
      "Bash(*python -m operations.pod.cli* create*)",
      "Bash(*python -m operations.pod.cli* adopt*)"
    ],
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(sh .githooks/check-static.sh)",
      "Bash(sh .githooks/check-all.sh)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(git fetch *)",
      "Bash(.venv/bin/python -m operations.bakeoff.queue_runner validate *)",
      "Bash(runpodctl version)",
      "Bash(runpodctl pod list *)",
      "Bash(runpodctl pod get *)",
      "Bash(runpodctl get pod *)",
      "Bash(runpodctl network-volume list*)",
      "Bash(runpodctl network-volume get *)",
      "mcp__ccd_session_mgmt__get_usage",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_session__mark_chapter",
      "mcp__ccd_settings__get_settings",
      "mcp__ccd_connectors__session_connectors_status"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/operations/pod/session_end_pod_check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
