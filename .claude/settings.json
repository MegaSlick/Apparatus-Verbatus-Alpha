{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git*push*--force*)",
      "Bash(git*push* -f*)",
      "Bash(git*commit*--no-verify*)",
      "Bash(git*commit* -n*)",
      "Bash(git*merge*--no-verify*)",
      "Bash(git*filter-branch*)",
      "Bash(git*filter-repo*)",
      "Bash(git*-c core.hooksPath*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --unset core.hooksPath*)"
    ],
    "ask": [
      "Bash(runpodctl create*)",
      "Bash(runpodctl pod create*)",
      "Bash(runpodctl start*)",
      "Bash(runpodctl pod start*)",
      "Bash(runpodctl resume*)",
      "Bash(runpodctl pod resume*)",
      "Bash(*operations.pod.cli*)",
      "Bash(*operations/pod/cli.py*)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/operations/pod/session_end_pod_check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
