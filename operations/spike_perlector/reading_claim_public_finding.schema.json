{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reading-claim-public-finding.v1",
  "title": "Aggregate-only public-safe Spec 05 finding",
  "description": "No identity, transcription, image, prompt, page, act, or free-text evidence is permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_sha256",
    "normalization_profile_id",
    "normalization_profile_sha256",
    "measure_quotes",
    "matrix",
    "input_baselines",
    "condition_deltas"
  ],
  "properties": {
    "schema": {"const": "reading-claim-public-finding.v1"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalization_profile_id": {"enum": ["graphemic-v1", "allographetic-v1"]},
    "normalization_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measure_quotes": {
      "type": "array",
      "items": {
        "enum": [
          "reference_length_cer_wer_v1",
          "missing_or_refused_is_empty_hypothesis_v1",
          "condition_matrix_complete_or_refused_v1",
          "dissent_is_structural_not_quality_v1",
          "cost_and_wall_time_observed_or_not_measured_v1"
        ]
      }
    },
    "matrix": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/matrix_row"}},
    "input_baselines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/baseline_row"}},
    "condition_deltas": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/delta_row"}}
  },
  "$defs": {
    "number_or_null": {"type": ["number", "null"]},
    "metrics": {
      "type": "object",
      "required": [
        "cell_count", "cer_errors", "cer_reference_units", "cer_matches", "cer", "wer_errors",
        "wer_reference_units", "wer_matches", "wer", "completeness", "complete_cells",
        "truncated_cells", "refused_cells", "missing_cells", "unavailable_cells",
        "malformed_cells", "dissent_compared", "dissent_departed", "dissent_unavailable",
        "dissent_rate", "elapsed_observed_cells", "mean_elapsed_ms",
        "cost_observed_cells", "mean_cost_usd"
      ],
      "properties": {
        "cell_count": {"type": "integer", "minimum": 0},
        "cer_errors": {"type": "integer", "minimum": 0},
        "cer_reference_units": {"type": "integer", "minimum": 1},
        "cer_matches": {"type": "integer", "minimum": 0},
        "cer": {"type": "number", "minimum": 0},
        "wer_errors": {"type": "integer", "minimum": 0},
        "wer_reference_units": {"type": "integer", "minimum": 1},
        "wer_matches": {"type": "integer", "minimum": 0},
        "wer": {"type": "number", "minimum": 0},
        "completeness": {"type": "number", "minimum": 0},
        "complete_cells": {"type": "integer", "minimum": 0},
        "truncated_cells": {"type": "integer", "minimum": 0},
        "refused_cells": {"type": "integer", "minimum": 0},
        "missing_cells": {"type": "integer", "minimum": 0},
        "unavailable_cells": {"type": "integer", "minimum": 0},
        "malformed_cells": {"type": "integer", "minimum": 0},
        "dissent_compared": {"type": "integer", "minimum": 0},
        "dissent_departed": {"type": "integer", "minimum": 0},
        "dissent_unavailable": {"type": "integer", "minimum": 0},
        "dissent_rate": {"$ref": "#/$defs/number_or_null"},
        "elapsed_observed_cells": {"type": "integer", "minimum": 0},
        "mean_elapsed_ms": {"$ref": "#/$defs/number_or_null"},
        "cost_observed_cells": {"type": "integer", "minimum": 0},
        "mean_cost_usd": {"$ref": "#/$defs/number_or_null"}
      }
    },
    "matrix_row": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/metrics"},
        {
          "type": "object",
          "required": ["subject_index", "condition"],
          "properties": {
            "subject_index": {"type": "integer", "minimum": 1},
            "condition": {"enum": ["lectio_nuda", "witness_primed", "image_absent_control"]}
          }
        }
      ]
    },
    "baseline_row": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/metrics"},
        {
          "type": "object",
          "required": ["source_index"],
          "properties": {"source_index": {"type": "integer", "minimum": 1}}
        }
      ]
    },
    "delta_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_index", "priming_cer_delta", "priming_wer_delta", "image_cer_delta", "image_wer_delta"],
      "properties": {
        "subject_index": {"type": "integer", "minimum": 1},
        "priming_cer_delta": {"type": "number"},
        "priming_wer_delta": {"type": "number"},
        "image_cer_delta": {"type": "number"},
        "image_wer_delta": {"type": "number"}
      }
    }
  }
}
